{
  "name": "badecision-model",
  "version": "0.1.0",
  "description": "Workspace: packages/core (shared JS + models), packages/badecision (the npm package), packages/model (training, eval, Studio tooling), packages/website (the Preact demo).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "test": "node packages/core/test/selftest.js && cd packages/model && node scripts/selftest.js",
    "dev": "pnpm --filter @badecision/website dev",
    "build:website": "pnpm --filter @badecision/website build",
    "data:seed": "pnpm --filter @badecision/model data:seed",
    "train": "pnpm --filter @badecision/model train",
    "train:distilled": "pnpm --filter @badecision/model train:distilled",
    "eval": "pnpm --filter @badecision/model eval",
    "ask": "pnpm --filter @badecision/model ask",
    "unsloth:probe": "pnpm --filter @badecision/model unsloth:probe",
    "unsloth:generate": "pnpm --filter @badecision/model unsloth:generate",
    "unsloth:label": "pnpm --filter @badecision/model unsloth:label",
    "unsloth:eval": "pnpm --filter @badecision/model unsloth:eval",
    "unsloth:export": "pnpm --filter @badecision/model unsloth:export",
    "unsloth:mock": "pnpm --filter @badecision/model unsloth:mock",
    "omens:generate": "pnpm --filter @badecision/model omens:generate",
    "decision:data": "pnpm --filter @badecision/model decision:data",
    "decision:train": "pnpm --filter @badecision/model decision:train",
    "decision:export": "pnpm --filter @badecision/model decision:export",
    "decision:eval": "pnpm --filter @badecision/model decision:eval",
    "eval:omens": "pnpm --filter @badecision/model eval:omens",
    "eval:serious": "pnpm --filter @badecision/model eval:serious",
    "pkg:build": "pnpm --filter badecision build",
    "pkg:kernel": "pnpm --filter badecision build:kernel",
    "pkg:test": "pnpm --filter badecision test",
    "pkg:browser": "node packages/badecision/scripts/serve.js"
  },
  "license": "MIT"
}
