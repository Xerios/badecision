{
  "name": "bad-decision-model",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace: packages/core (shared JS + models), packages/badecision (the npm package), research/ (training, eval, Studio tooling), packages/website (the Preact demo).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "test": "node packages/core/test/selftest.js && cd research && node scripts/selftest.js",
    "dev": "pnpm --filter @badecision/website dev",
    "build:website": "pnpm --filter @badecision/website build",
    "data:seed": "pnpm --filter @badecision/research data:seed",
    "train": "pnpm --filter @badecision/research train",
    "train:distilled": "pnpm --filter @badecision/research train:distilled",
    "eval": "pnpm --filter @badecision/research eval",
    "ask": "pnpm --filter @badecision/research ask",
    "unsloth:probe": "pnpm --filter @badecision/research unsloth:probe",
    "unsloth:generate": "pnpm --filter @badecision/research unsloth:generate",
    "unsloth:label": "pnpm --filter @badecision/research unsloth:label",
    "unsloth:eval": "pnpm --filter @badecision/research unsloth:eval",
    "unsloth:export": "pnpm --filter @badecision/research unsloth:export",
    "unsloth:mock": "pnpm --filter @badecision/research unsloth:mock",
    "omens:generate": "pnpm --filter @badecision/research omens:generate",
    "decision:data": "pnpm --filter @badecision/research decision:data",
    "decision:train": "pnpm --filter @badecision/research decision:train",
    "decision:export": "pnpm --filter @badecision/research decision:export",
    "decision:eval": "pnpm --filter @badecision/research decision:eval",
    "eval:omens": "pnpm --filter @badecision/research eval:omens",
    "eval:serious": "pnpm --filter @badecision/research eval:serious",
    "pkg:build": "pnpm --filter badecision build",
    "pkg:kernel": "pnpm --filter badecision build:kernel",
    "pkg:test": "pnpm --filter badecision test",
    "pkg:browser": "node packages/badecision/scripts/serve.js"
  },
  "license": "MIT"
}
